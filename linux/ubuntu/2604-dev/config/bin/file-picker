#!/usr/bin/env bash
set -euo pipefail

# =============================================================================
# This script performs the following tasks:
# - Fuzzy-picks a file with fd and fzf
# - Sends its path into the calling pane, relative if the file is under the
#   popup's working directory and absolute otherwise
#
# Deployed to ~/.local/bin by setup-06-configs.sh and bound to prefix+C-f by
# both tmux.conf and the herdr config.toml. It needs fd (fdfind on Ubuntu) and
# fzf, which setup-00-packages.sh installs.
#
# It works under both multiplexers because only the final send differs:
# - tmux passes the pane id in TMUX_FILE_PICKER_TARGET (see tmux.conf)
# - herdr passes it in HERDR_ACTIVE_PANE_ID for custom commands
# With neither set the path is printed on stdout, so it stays usable on its
# own and in a pipeline.
# =============================================================================

# -----------------------------------------------------------------------------
# Read one NUL-terminated value
# -----------------------------------------------------------------------------
# Every path here is captured through this rather than $(...): a command
# substitution strips trailing newlines, so a name ending in one would come
# out as a different name. read -d '' stops at the NUL the producers below
# (realpath -z, fzf --print0) end their output with. Returns non-zero when
# nothing was read, which is how a cancelled pick is told apart.
read_nul() {
    IFS= read -r -d '' "$1"
}
# Assigned through read_nul, which shellcheck cannot see.
cwd_abs='' root='' selection='' abs=''

# -----------------------------------------------------------------------------
# Determine the search root
# -----------------------------------------------------------------------------
# The whole git project if the popup's working directory is inside one, the
# working directory itself otherwise. git prints the path with one newline
# after it and has no -z for this; head -c -1 drops that byte alone, so a
# newline inside the name survives, and the NUL is added by hand. Outside a
# repository git fails and prints nothing - the || true keeps the failed
# pipeline from ending the substitution before the NUL is written - and the
# empty result falls back to the working directory.
read_nul cwd_abs < <(realpath -z -- "$PWD")
read_nul root < <(
    git rev-parse --show-toplevel 2> /dev/null | head -c -1 || true
    printf '\0'
)
[ -n "$root" ] || root=$cwd_abs

# -----------------------------------------------------------------------------
# Find fd
# -----------------------------------------------------------------------------
# Ubuntu ships the binary as fdfind; setup-00-packages.sh also links it as fd,
# and either name will do.
if command -v fdfind > /dev/null 2>&1; then
    fd_cmd=fdfind
elif command -v fd > /dev/null 2>&1; then
    fd_cmd=fd
else
    printf 'file-picker: fd/fdfind not found\n' >&2
    exit 1
fi

# -----------------------------------------------------------------------------
# Pick a file
# -----------------------------------------------------------------------------
# Hidden files are included, the .git directory is not. The candidates are
# NUL-delimited end to end (fd -0, fzf --read0/--print0), so a name with a
# newline in it is one candidate rather than two fragments. Cancelling fzf
# (Esc or Ctrl-C) prints nothing, and read_nul then fails: nothing gets sent.
read_nul selection < <(
    "$fd_cmd" -0 --type f --hidden --exclude .git . "$root" |
        fzf --read0 --print0 --reverse --prompt 'file > ' --no-multi --height 100%
) || exit 0

[ -z "$selection" ] && exit 0

# -----------------------------------------------------------------------------
# Make the path relative when it is under the popup's working directory
# -----------------------------------------------------------------------------
# fd prints paths under $root, which may be above the working directory, so
# the result is normalised first and then stripped of the cwd prefix when it
# has one. Anything outside the working directory stays absolute.
read_nul abs < <(realpath -z -- "$selection")

case "$abs" in
    "$cwd_abs"/*) out=${abs#"$cwd_abs"/} ;;
    "$cwd_abs") out='.' ;;
    *) out="$abs" ;;
esac

# -----------------------------------------------------------------------------
# Send the path into the calling pane
# -----------------------------------------------------------------------------
# tmux types it literally (-l) into the pane the binding recorded; herdr does
# the same through its pane API. What is typed lands on a shell prompt, so
# the path is shell-quoted first (printf %q): a space, an apostrophe or a
# newline in the name would otherwise split the word, open a quote or submit
# the line. A plain path is unchanged by %q, so the usual case reads as
# before. Without a pane the raw path goes to stdout, where a pipeline wants
# it unquoted.
if [ -n "${TMUX_FILE_PICKER_TARGET:-}" ]; then
    tmux send-keys -l -t "$TMUX_FILE_PICKER_TARGET" -- "$(printf '%q' "$out")"
elif [ -n "${HERDR_ACTIVE_PANE_ID:-}" ]; then
    "${HERDR_BIN_PATH:-herdr}" pane send-text "$HERDR_ACTIVE_PANE_ID" "$(printf '%q' "$out")"
else
    printf '%s\n' "$out"
fi
